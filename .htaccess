# Apache 2.4 configuration for the static site at the domain root.
# Installed as a marked block; existing hosting configuration is preserved.
Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set X-Frame-Options "SAMEORIGIN"
 Header always set Referrer-Policy "strict-origin-when-cross-origin"
 Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
 <FilesMatch "\.(html|xml|txt)$">
  Header set Cache-Control "no-cache"
 </FilesMatch>
 <FilesMatch "\.(css|js|svg|png|jpg|webp|ico|woff2)$">
  Header set Cache-Control "public, max-age=604800"
 </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_rewrite.c>
 RewriteEngine On
 RewriteRule (^|/)\.(?!well-known/) - [F,L]
 RewriteRule ^(?:docs|scripts)/ - [F,L]
</IfModule>
<FilesMatch "(^\.|package(-lock)?\.json$|\.map$|\.log$|\.bak$|\.sql$)">
 Require all denied
</FilesMatch>
